# Set this to the existing Railway PostgreSQL service's connection string.
DATABASE_URL=

# Optional AI providers. At least one is required for text-based Agents and Labs.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Optional Realtime model override; voice sessions default to gpt-realtime-2.1.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional IP geolocation provider credentials.
IPGEOLOCATION_API_KEY=
IP_GEOLOCATION_API_KEY=
WHOIS_API_KEY=

# Password-reset email delivery.
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
