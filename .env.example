# ---- Site ----
# Canonical production URL — drives metadataBase, Open Graph, sitemap, robots,
# and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sanbayfusion.com

# ---- Sanity (CMS) ----
# Leave blank to run with bundled seed content. Set these once you create a
# Sanity project (npx sanity init) to enable the Studio at /studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---- Supabase / Postgres (reservations) ----
# Pooled connection string used at runtime (Transaction pooler, port 6543).
DATABASE_URL=
# Direct connection (port 5432) used for migrations.
DIRECT_URL=

# ---- Resend (transactional email) ----
RESEND_API_KEY=
# Verified sender for transactional email.
RESERVATION_FROM_EMAIL="Sanbay Fusion Bar & Restaurant <info@sanbayfusion.com>"
# Where staff booking notifications are sent.
RESTAURANT_NOTIFY_EMAIL=info@sanbayfusion.com
