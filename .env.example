# ---- Site ----
# Canonical production URL — drives metadataBase, Open Graph, sitemap, robots,
# and JSON-LD, plus the exact trusted origin for API mutations and sign-in actions.
# Behind Railway/proxies, use the public HTTPS URL, never the internal host/port.
# Railway's exact RAILWAY_PUBLIC_DOMAIN is also trusted (no wildcard domains).
NEXT_PUBLIC_SITE_URL=https://sanbayfusion.com
# Enable only after the pay host and its payment/session/webhook flows are verified.
NEXT_PUBLIC_PAYMENT_HOST_ENABLED=false
# Optional Search Console HTML-tag ownership token (value only, not the full tag).
# Set in Railway, redeploy, then complete Google's verification. This is not Analytics.
GOOGLE_SITE_VERIFICATION=

# ---- Google Maps delivery checker ----
# Browser-restricted key for Maps JavaScript API + Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only key for Geocoding / Routes APIs. Never expose this to the browser.
GOOGLE_MAPS_SERVER_API_KEY=
# Dispatch origin for future Routes API driving-distance checks.
DELIVERY_ORIGIN_LATITUDE=
DELIVERY_ORIGIN_LONGITUDE=

# ---- Sanity (CMS) ----
# Leave blank to run with bundled seed content. Set these once you create a
# Sanity project (npx sanity init) to enable the Studio at /studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ---- Supabase / Postgres (reservations) ----
# Pooled connection string used at runtime (Transaction pooler, port 6543).
DATABASE_URL=
# Direct connection (port 5432) used for migrations.
DIRECT_URL=

# ---- Resend (transactional email) ----
RESEND_API_KEY=
# Verified sender for transactional email.
RESERVATION_FROM_EMAIL="Sanbay Fusion Bar & Restaurant <info@sanbayfusion.com>"
# Where staff booking notifications are sent.
RESTAURANT_NOTIFY_EMAIL=info@sanbayfusion.com
# Comma-separated staff accounts allowed to approve paid memberships.
MEMBERSHIP_ADMIN_EMAILS=

# ---- Stripe sandbox / payments ----
# Publishable key is safe for browser Payment Element initialization.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only secret; never expose to client code.
STRIPE_SECRET_KEY=
# Optional connected-account context for future Stripe Connect flows.
STRIPE_ACCOUNT_ID=
# Server-only webhook signing secret; comma-separated values are supported temporarily during Sandbox endpoint migration.
STRIPE_WEBHOOK_SECRET=

# 32-byte hex key for authenticated encryption of account TOTP secrets. Keep stable and private.
ACCOUNT_SECURITY_KEY=
