    "@radix-ui/react-slot": "^1.3.0",
    "@react-email/components": "^1.0.12",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lenis": "^1.3.25",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "next": "^16.2.11",
    "next-sanity": "^13.1.1",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "resend": "^6.16.0",
    "sanity": "^6.2.0",
    "sonner": "^2.0.7",
    "styled-components": "^6.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
