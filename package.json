{
  "name": "sanbay-fusion",
  "version": "0.1.0",
  "description": "A cinematic Next.js portfolio build for a fictional Michelin-starred restaurant, with a Sanity-managed menu & story and a real reservation system.",
  "author": "Zakaria Shahruri",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
